# Applied before Squid starts. A changed DNS answer cannot reach a blocked peer.
add table inet agy_proxy
flush table inet agy_proxy
add chain inet agy_proxy output { type filter hook output priority filter; policy accept; }
add rule inet agy_proxy output meta skuid "proxy" tcp dport 443 ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, PUBLIC_IP } reject
add rule inet agy_proxy output meta skuid "proxy" meta nfproto ipv6 tcp dport 443 reject
